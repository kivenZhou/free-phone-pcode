# Optional: comma-separated provider ids to disable, e.g. receive-smss,smstome
# DISABLED_PROVIDERS=

# Parallel provider sync concurrency (default 5)
# REFRESH_CONCURRENCY=5

# SMS24 scrape tuning
# SMS24_MAX_PAGES=20
# SMS24_CONCURRENCY=10

# Optional: protect POST /api/refresh in production (Bearer token)
# REFRESH_TOKEN=your-secret-token

# GitHub Pages static build (npm run build:pages)
# PAGES_MESSAGE_LIMIT=300
# PAGES_MESSAGE_CONCURRENCY=5

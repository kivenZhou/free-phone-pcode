# Optional: comma-separated provider ids to disable, e.g. receive-smss,smstome
# DISABLED_PROVIDERS=

# Parallel provider sync concurrency (default 5 locally, 1 on Cloudflare)
# REFRESH_CONCURRENCY=5

# Providers per Worker invocation on Cloudflare (default 1 — stays under free-plan subrequest limits)
# REFRESH_BATCH_SIZE=1

# SMS24 scrape tuning
# SMS24_MAX_PAGES=20
# SMS24_CONCURRENCY=10

# Optional: protect POST /api/refresh in production (Bearer token)
# REFRESH_TOKEN=your-secret-token

# Cloudflare 定时任务 /api/cron/refresh 鉴权（Bearer token）
# CRON_SECRET=your-cron-secret

# GitHub Pages static build (npm run build:pages)
# PAGES_MESSAGE_LIMIT=300
# PAGES_MESSAGE_CONCURRENCY=5

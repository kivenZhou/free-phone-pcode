{
  "name": "free-phone-pcode",
  "version": "0.1.0",
  "description": "Open-source aggregator for publicly displayed temporary SMS inboxes from multiple third-party sites",
  "license": "MIT",
  "private": false,
  "keywords": [
    "sms",
    "verification-code",
    "temporary-phone-number",
    "aggregator",
    "nextjs",
    "receive-sms",
    "otp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kivenZhou/free-phone-pcode.git"
  },
  "bugs": {
    "url": "https://github.com/kivenZhou/free-phone-pcode/issues"
  },
  "homepage": "https://kivenzhou.github.io/free-phone-pcode/",
  "scripts": {
    "build": "next build --webpack",
    "build:pages": "node scripts/build-pages.mjs",
    "setup:cf-kv": "node scripts/setup-cf-kv.mjs",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "dev": "next dev",
    "lint": "eslint"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "impit": "^0.14.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.14.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "wrangler": "^4.86.0"
  }
}
